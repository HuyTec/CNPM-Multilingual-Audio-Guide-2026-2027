  <diagram name="Mục lục và phạm vi" id="W1F_hoUJD-Jt7MPy0o14">
    <mxGraphModel grid="0" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#152338;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=34;fontStyle=1;" value="DFD TravelVoice · Web và Backend" vertex="1">
          <mxGeometry height="54" width="1500" x="48" y="32" as="geometry" />
        </mxCell>
        <mxCell id="scope" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#152338;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;" value="Source đối chứng 6e1faf8 · Backend, Tourist Web và Web Admin" vertex="1">
          <mxGeometry height="34" width="1500" x="48" y="93" as="geometry" />
        </mxCell>
        <mxCell id="group-0" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#152338;rounded=0;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=15;" value="&lt;b&gt;01 · Chọn địa điểm và nghe thuyết minh&lt;/b&gt;&lt;br&gt;&lt;br&gt;Khám phá, tra bài và phát audio/TTS. Đồng bộ sự kiện phát, cài gói WEB và thông báo theo vị trí.&lt;br&gt;&lt;br&gt;&lt;a href=&quot;data:page/id,ONj4w_kXXoPEmxpZLqfM&quot;&gt;1 · M0 Ngữ cảnh&lt;/a&gt; · &lt;a href=&quot;data:page/id,-aExwn2cRNALNPq0CugY&quot;&gt;1 · M1 Tiến trình&lt;/a&gt; · &lt;a href=&quot;data:page/id,s92zbhjypcu3pGcbxujE&quot;&gt;1 · M2 1.1&lt;/a&gt; · &lt;a href=&quot;data:page/id,tRe3X6A7-PflpPr9_p7R&quot;&gt;1 · M2 1.2&lt;/a&gt; · &lt;a href=&quot;data:page/id,w2zAcnvJTC7s_2ygZ3_G&quot;&gt;1 · M2 1.3&lt;/a&gt;" vertex="1">
          <mxGeometry height="178" width="480" x="48" y="150" as="geometry" />
        </mxCell>
        <mxCell id="group-1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#152338;rounded=0;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=15;" value="&lt;b&gt;02 · Tạo, duyệt và xuất bản nội dung&lt;/b&gt;&lt;br&gt;&lt;br&gt;Biên tập bản làm việc, xét duyệt và xuất bản gói. Quản lý phiên Web Admin và hỗ trợ dịch.&lt;br&gt;&lt;br&gt;&lt;a href=&quot;data:page/id,SPL05dIYVVhWSYcXHGvN&quot;&gt;2 · M0 Ngữ cảnh&lt;/a&gt; · &lt;a href=&quot;data:page/id,iFMnxojgl4TQDEy-ThNa&quot;&gt;2 · M1 Tiến trình&lt;/a&gt; · &lt;a href=&quot;data:page/id,NE79KZ0MWhq4RkxOd7vQ&quot;&gt;2 · M2 2.1&lt;/a&gt; · &lt;a href=&quot;data:page/id,ySvTljlKLJ6VVUvmWmMX&quot;&gt;2 · M2 2.2&lt;/a&gt; · &lt;a href=&quot;data:page/id,9t7L-AKMOQzgKaEZEWHh&quot;&gt;2 · M2 2.3&lt;/a&gt;" vertex="1">
          <mxGeometry height="178" width="480" x="554" y="150" as="geometry" />
        </mxCell>
        <mxCell id="group-2" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#152338;rounded=0;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=15;" value="&lt;b&gt;03 · Theo dõi và xem thông số du khách&lt;/b&gt;&lt;br&gt;&lt;br&gt;Heartbeat, ghi lượt phát, tổng hợp hiện diện và số liệu phát, quản lý phản hồi và xuất XLSX.&lt;br&gt;&lt;br&gt;&lt;a href=&quot;data:page/id,4BFxik00jIWMADtLRC0g&quot;&gt;3 · M0 Ngữ cảnh&lt;/a&gt; · &lt;a href=&quot;data:page/id,YAic8OaFudvTeQbER9AV&quot;&gt;3 · M1 Tiến trình&lt;/a&gt; · &lt;a href=&quot;data:page/id,wof3vZhKGqhCD6_VsZ_0&quot;&gt;3 · M2 3.1&lt;/a&gt; · &lt;a href=&quot;data:page/id,Lx0tA3a8fPtkNNlpMyLR&quot;&gt;3 · M2 3.2&lt;/a&gt; · &lt;a href=&quot;data:page/id,butP2YLdDA-Deq71Y23L&quot;&gt;3 · M2 3.3&lt;/a&gt;" vertex="1">
          <mxGeometry height="178" width="480" x="1060" y="150" as="geometry" />
        </mxCell>
        <mxCell id="note-0" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#152338;rounded=0;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=16;" value="&lt;b&gt;Đọc ký hiệu&lt;/b&gt;&lt;br&gt;Hình chữ nhật là thực thể ngoài ranh giới đang xét. Hình elip là tiến trình biến đổi dữ liệu. Hai đường song song là kho dữ liệu. Elip nét đứt ở M2 tham chiếu tiến trình khác của M1. F đánh số riêng theo trang. M1 ghi F của M0 cho luồng qua biên; M2 ghi F của M1 cho luồng đi qua biên tiến trình." vertex="1">
          <mxGeometry height="104" width="1493" x="48" y="358" as="geometry" />
        </mxCell>
        <mxCell id="note-1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#152338;rounded=0;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=16;" value="&lt;b&gt;Kết nối giữa các nhóm&lt;/b&gt;&lt;br&gt;D01 do nhóm 2 ghi; nhóm 1 và 3 đọc. D03 chuyển lượt bắt đầu phát kèm cặp installationId/platform nếu có sang 3.2. D06 do 2.2/2.3 ghi; 1.4 đọc phiên bản WEB READY rồi ghi D02 sau xác minh. DS-09 cung cấp khóa công khai; dữ liệu khóa khởi tạo/lưu khi backend khởi động (PackageSigner, SigningKeyRepository)." vertex="1">
          <mxGeometry height="104" width="1493" x="48" y="484" as="geometry" />
        </mxCell>
        <mxCell id="note-2" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#152338;rounded=0;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=16;" value="&lt;b&gt;Phạm vi gói và thông báo&lt;/b&gt;&lt;br&gt;Worker tạo BASE, OPTIONAL và WEB; Tourist Web đọc/cài WEB. 1.5 mô tả theo dõi phiên Web mở, cooldown và thông báo nếu được hỗ trợ; theo dõi nền trên thiết bị chưa được xác nhận. Android nằm ngoài phạm vi đối chiếu này." vertex="1">
          <mxGeometry height="104" width="1493" x="48" y="610" as="geometry" />
        </mxCell>
        <mxCell id="note-3" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#152338;rounded=0;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=16;" value="&lt;b&gt;Phạm vi quản trị và thông số&lt;/b&gt;&lt;br&gt;2.4 xác thực phiên; 2.5 hỗ trợ dịch. 3.4 quản lý phản hồi; 3.5 xuất XLSX sau khi lấy thống kê và phản hồi theo kỳ/bộ lọc. Quyền analytics/feedback đang dùng chung EDITOR và REVIEWER; vai trò Quản trị hệ thống/Chủ sản phẩm theo PRD cần được chốt." vertex="1">
          <mxGeometry height="104" width="1493" x="48" y="736" as="geometry" />
        </mxCell>
        <mxCell id="dfd-ext-note" parent="1" value="M0/M1 có thể lặp hình tác nhân hoặc tiến trình trong các khối để tách tuyến vẽ. Cùng tên và mã biểu thị cùng một đối tượng logic. Mã F được tra theo từng trang." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#152338;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;" vertex="1">
          <mxGeometry x="56" y="862" width="1160" height="62" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
