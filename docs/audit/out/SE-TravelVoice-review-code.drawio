        <mxCell id="code-head" parent="RRGjnYU3gMf1zEvawTjR-8" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#152338;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" value="P · Các bước xử lý và vị trí trong source" vertex="1">
