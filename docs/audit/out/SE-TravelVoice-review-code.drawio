        <mxCell id="code-1" parent="FhITEkXkcUetySaOUA9C-2" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#152338;rounded=0;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;strokeColor=none;fillColor=none;verticalAlign=top;spacingTop=12;fontSize=14;" value="&lt;b&gt;1.3.2 Phát bài và cập nhật trạng thái&lt;/b&gt;&lt;br&gt;1. Cập nhật trạng thái khi phát bắt đầu; xử lý tạm dừng và đổi tốc độ từ bộ điều khiển.&lt;br&gt;&amp;nbsp;&amp;nbsp;GuidePlayback.didStart() · web-user/src/lib/playback.ts:60&lt;br&gt;&amp;nbsp;&amp;nbsp;GuidePlayback.pause() · web-user/src/lib/playback.ts:138&lt;br&gt;&amp;nbsp;&amp;nbsp;GuidePlayback.setRate() · web-user/src/lib/playback.ts:162" vertex="1">
          <mxGeometry height="174" width="1672" y="1107" as="geometry" />
        </mxCell>
        <mxCell id="code-2" parent="FhITEkXkcUetySaOUA9C-2" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#152338;rounded=0;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;strokeColor=none;fillColor=none;verticalAlign=top;spacingTop=12;fontSize=14;" value="&lt;b&gt;1.3.3 Ghi và đồng bộ lượt bắt đầu phát&lt;/b&gt;&lt;br&gt;1. Ghi biên nhận khi phát thực sự, gắn cờ ngoại tuyến theo nguồn bài hoặc kết nối.&lt;br&gt;&amp;nbsp;&amp;nbsp;GuidePlayer() · callback khi bắt đầu phát · web-user/src/components/GuidePlayer.tsx:7&lt;br&gt;&lt;br&gt;2. Tạo mã sự kiện và lưu/gửi lại từ hàng đợi.&lt;br&gt;&amp;nbsp;&amp;nbsp;recordPlayback() · web-user/src/lib/playbackOutbox.ts:47&lt;br&gt;&amp;nbsp;&amp;nbsp;retryOutbox() · web-user/src/lib/playbackOutbox.ts:69&lt;br&gt;&lt;br&gt;3. Xử lý phản hồi, phân lỗi cần thử lại và lỗi bị từ chối.&lt;br&gt;&amp;nbsp;&amp;nbsp;flushReceipts() · web-user/public/playback-outbox.js:49&lt;br&gt;&lt;br&gt;Khi có định danh cài đặt, hàng đợi gắn thêm cặp installationId/platform vào dữ liệu gửi API.&lt;br&gt;web-user/public/playback-outbox.js:L49-L70" vertex="1">
