        <mxCell id="code-0" parent="RRGjnYU3gMf1zEvawTjR-8" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#152338;rounded=0;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;strokeColor=none;fillColor=#ffffff;verticalAlign=top;spacingTop=12;fontSize=14;" value="&lt;b&gt;1.1.1 Lấy danh mục địa điểm&lt;/b&gt;&lt;br&gt;1. Đọc danh mục điểm qua API theo danh mục và ngôn ngữ.&lt;br&gt;&amp;nbsp;&amp;nbsp;useLocationCatalog() → load() · web-user/src/lib/useLocationCatalog.ts:25&lt;br&gt;&amp;nbsp;&amp;nbsp;CategoryFilter() · web-user/src/components/CategoryFilter.tsx:21&lt;br&gt;&lt;br&gt;2. Khi lỗi cho phép, lấy danh sách từ gói đã xác minh.&lt;br&gt;&amp;nbsp;&amp;nbsp;useLocationCatalog() → load() · nhánh đọc local · web-user/src/lib/useLocationCatalog.ts:52" vertex="1">
          <mxGeometry height="210" width="1672" y="42" as="geometry" />
        </mxCell>
        <mxCell id="code-1" parent="RRGjnYU3gMf1zEvawTjR-8" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#152338;rounded=0;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;strokeColor=none;fillColor=#ffffff;verticalAlign=top;spacingTop=12;fontSize=14;" value="&lt;b&gt;1.1.2 Lọc, xếp kết quả và xác định điểm&lt;/b&gt;&lt;br&gt;1. Đọc mã điểm khi mở liên kết hoặc lọc tên trong danh sách hiện tại.&lt;br&gt;&amp;nbsp;&amp;nbsp;LocationEntry() → openLocation() · web-user/src/pages/LocationEntry.tsx:12&lt;br&gt;&amp;nbsp;&amp;nbsp;LocationCatalog() · useMemo tính matches · web-user/src/components/LocationCatalog.tsx:22&lt;br&gt;&amp;nbsp;&amp;nbsp;GuidePage() · web-user/src/pages/GuidePage.tsx:48&lt;br&gt;&lt;br&gt;2. Nếu tìm gần, lấy vị trí rồi tính khoảng cách, lọc theo bán kính và sắp xếp tăng dần.&lt;br&gt;&amp;nbsp;&amp;nbsp;TourMap() → startNearby() · web-user/src/components/TourMap.tsx:104&lt;br&gt;&amp;nbsp;&amp;nbsp;NearbyPlaces() · useMemo tính nearby · web-user/src/components/NearbyPlaces.tsx:53&lt;br&gt;&amp;nbsp;&amp;nbsp;useBrowserLocation() → acquire() · web-user/src/lib/useBrowserLocation.ts:13" vertex="1">
          <mxGeometry height="288" width="1672" y="264" as="geometry" />
        </mxCell>
        <mxCell id="code-2" parent="RRGjnYU3gMf1zEvawTjR-8" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#152338;rounded=0;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;strokeColor=none;fillColor=#ffffff;verticalAlign=top;spacingTop=12;fontSize=14;" value="&lt;b&gt;1.1.3 Yêu cầu và hiển thị ô bản đồ&lt;/b&gt;&lt;br&gt;1. Lấy các ô nền theo vùng đang xem; đổi nguồn khi nguồn chính lỗi.&lt;br&gt;&amp;nbsp;&amp;nbsp;attachMapTiles() · web-user/src/lib/mapTiles.ts:13&lt;br&gt;&lt;br&gt;2. Dựng ghim từ danh sách điểm và liên kết đến chi tiết.&lt;br&gt;&amp;nbsp;&amp;nbsp;TourMap() · useEffect dựng ghim · web-user/src/components/TourMap.tsx:209" vertex="1">
