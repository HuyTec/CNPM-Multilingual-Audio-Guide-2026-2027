# Copy to .env.demo.local, replace both passwords. Do not commit the local file.
POSTGRES_PASSWORD=replace_with_demo_database_password
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=replace_with_demo_admin_password
SPRING_PROFILES_ACTIVE=demo
BACKEND_PORT=8081
WEB_PORT=3001
# 0.0.0.0 permits phones on the same trusted Wi-Fi. Use 127.0.0.1 for emulator only.
BACKEND_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1
